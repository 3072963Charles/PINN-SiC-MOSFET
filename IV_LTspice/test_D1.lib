.SUBCKT FYP_ORIGIN GATE DRAIN SOURCE
 *  CONSTANT
 .PARAM  u_4H_SiC = 720 q = 1.602e-19 RD = 23e-3 Epsilon0 = 8.854187817e-12 EpsilonSiC = 7 * 8.854187817e-12
 CGD DRAIN GATE Q = (134999718321905525*101**(8301/10000)*200**(1699/10000))/(70573698901205377126986506106759544832*(1/(x + 101/200))**(1699/10000))
 CDS DRAIN SOURCE Q = 2**(12/25)/(960000000000000*(1/(x + 1/2))**(12/25))
 CGS GATE SOURCE 0.000000000000000585955870764865
 *  PARAMETER OF IV
 .PARAM P1 = 1.141716113546302979742108618666 P2 = 0.767113121288285015886287965259 P3 = 3.611508109080384887334957966232 as = 0.268448677805323998590836254152 Vpk0 = 9.367275666132254485773955821060 Vpks = 9.196535409034860109045439457987
 .PARAM ALPHA_1=0.000122391549498198612443491951 ALPHA_2=-0.004301149853143999661486684971 ALPHA_3=0.022028603005521001090283306212 ALPHA_4=0.541506201518383023518765639892
 .PARAM BETA_1=-0.037436671972721997925237502614 BETA_2=1.887523041469407969472626973584 BETA_3=-29.061496665745053746832127217203 BETA_4=155.643655323090399633656488731503
.PARAM LAMBDA_1=0.000000486314833002034176544118 LAMBDA_2=-0.000047250106209262857310041128 LAMBDA_3=0.001902005775585999952648208478
 .PARAM LAMBDA_4=-0.040919366350026999124001036989 LAMBDA_5=0.505596931001759952728491498419 LAMBDA_6=-3.574488135690543799682927783579 LAMBDA_7=13.390874599767666808247668086551 LAMBDA_8=-20.553060805654943976605864008889
 .FUNC ALPHA(Vgs) {ALPHA_1 * Vgs**3+ALPHA_2 * Vgs**2+ALPHA_3 * Vgs**1+ALPHA_4 * Vgs**0}
 .FUNC BETA(Vgs) {BETA_1 * Vgs**3+BETA_2 * Vgs**2+BETA_3 * Vgs**1+BETA_4 * Vgs**0}
 .FUNC LAMBDA(Vgs)  {LAMBDA_1 * Vgs**7+LAMBDA_2 * Vgs**6+LAMBDA_3 * Vgs**5+LAMBDA_4 * Vgs**4+LAMBDA_5 * Vgs**3+LAMBDA_6 * Vgs**2+LAMBDA_7 * Vgs**1+LAMBDA_8 * Vgs**0}
 bswitch DRAIN SOURCE I = BETA(V(GATE,SOURCE))*(1+tanh((P1*(V(GATE,SOURCE) - (Vpk0 + (Vpks-Vpk0)*tanh(as*V(DRAIN,SOURCE)))) + P2*(V(GATE,SOURCE) - (Vpk0 + (Vpks-Vpk0)*tanh(as*V(DRAIN,SOURCE))))**2 + P3*(V(GATE,SOURCE) - (Vpk0 + (Vpks-Vpk0)*tanh(as*V(DRAIN,SOURCE))))**3)))*(1+LAMBDA(V(GATE,SOURCE))*V(DRAIN,SOURCE))*tanh(ALPHA(V(GATE,SOURCE))*V(DRAIN,SOURCE));
 .ends
